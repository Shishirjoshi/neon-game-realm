# ==========================================
# Gamehub Environment Configuration
# ==========================================

# Application Settings
VITE_APP_NAME=Gamehub
VITE_APP_DESCRIPTION=Premium browser multiplayer gaming arena
NODE_ENV=development

# Socket.IO Configuration (for multiplayer games)
VITE_SOCKET_URL=http://localhost:3001

# Chess Game Configuration
VITE_CHESS_DIFFICULTY_DEFAULT=medium
VITE_CHESS_BOT_THINK_TIME_MIN=500
VITE_CHESS_BOT_THINK_TIME_MAX=1500
VITE_CHESS_ENABLE_CASTLING=true
VITE_CHESS_ENABLE_EN_PASSANT=false

# Feature Flags
VITE_ENABLE_MULTIPLAYER=true
VITE_ENABLE_OFFLINE_GAMES=true
VITE_ENABLE_STATS_TRACKING=true
VITE_ENABLE_LEADERBOARD=true

# Authentication & Database (Supabase)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_key

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Deployment URLs
VITE_DEPLOY_URL=http://localhost:8081
VITE_API_BASE_URL=http://localhost:3001

# Logging
VITE_LOG_LEVEL=info
